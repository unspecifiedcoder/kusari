# Copy to .env and fill in. Never commit .env.

# Wallets (Sepolia)
OWNER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=

# RPC
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Agent reads go here. Set to the Anon-RPC bridge (http://localhost:8546) once it's running.
AGENT_READ_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# LLM (agent decision call)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5

# ENS
ENS_PARENT_NAME=
ENS_AGENT_LABEL=alpha

# Frontend
NEXT_PUBLIC_REOWN_PROJECT_ID=
ETHERSCAN_API_KEY=

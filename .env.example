# Copy to .env and fill in. Never commit .env.  Check it with: node scripts/check-env.mjs

# Wallets (Sepolia)
OWNER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=

# RPC. Agent reads AND transactions go through the Anon-RPC bridge (reader/, :8546) by default.
# Leave these empty unless you mean to bypass it (the demo's leak toggle uses the logging proxy on :8547).
AGENT_READ_RPC_URL=
AGENT_WRITE_RPC_URL=
# Only for deploys and one-off admin scripts that should not use the bridge.
SEPOLIA_RPC_URL=

# LLM (the agent's decision call)
GEMINI_API_KEY=
AGENT_MODEL=gemini-flash-lite-latest

# ENS
ENS_PARENT_LABEL=kusari-demo
ENS_AGENT_LABEL=alpha

# Frontend (optional)
NEXT_PUBLIC_REOWN_PROJECT_ID=
ETHERSCAN_API_KEY=

  "captions": [
    {
      "start": 0.0,
      "end": 6.0,
      "phase": "intro",
      "text": "Kusari gives AI agents a public ENS policy and onchain trading limits.",
      "lines": [
        "Kusari gives AI agents a public ENS policy and onchain trading limits."
      ]
    },
    {
      "start": 6.0,
      "end": 12.999999999999996,
      "phase": "baseline-fixed-test",
      "text": "The first test is deterministic: request exactly 2 kUSD from the shared Sepolia vault.",
      "lines": [
        "The first test is deterministic: request exactly 2 kUSD from the shared Sepolia vault."
      ]
    },
    {
      "start": 12.999999999999996,
      "end": 19.999999999999993,
      "phase": "baseline-fixed-test",
      "text": "With the owner's per-trade cap at 5 kUSD, this request fits the amount limit.",
      "lines": [
        "With the owner's per-trade cap at 5 kUSD, this request fits the amount limit."
      ]
    },
    {
      "start": 19.999999999999993,
      "end": 27.999999999999993,
      "phase": "baseline-confirmed",
      "text": "The 2 kUSD swap is confirmed on Sepolia. This is a new transaction from this recorded browser session.",
      "lines": [
        "The 2 kUSD swap is confirmed on Sepolia. This is a new transaction from this recorded browser session."
      ]
    },
    {
      "start": 27.999999999999993,
      "end": 39.999999999999986,
      "phase": "edit-cap-one",
      "text": "The owner changes the per-trade cap from 5 to 1 kUSD. The wallet writes the ENS resolver's kusari.policy data.",
      "lines": [
        "The owner changes the per-trade cap from 5 to 1 kUSD. The wallet writes the ENS resolver's kusari.policy data."
      ]
    },
    {
      "start": 39.999999999999986,
      "end": 47.999999999999986,
      "phase": "cap-one-confirmed",
      "text": "The ENS policy update has confirmed. Kusari now reads a 1 kUSD per-trade cap.",
      "lines": [
        "The ENS policy update has confirmed. Kusari now reads a 1 kUSD per-trade cap."
      ]
    },
    {
      "start": 47.999999999999986,
      "end": 59.99999999999999,
      "phase": "repeat-two-at-one",
      "text": "Run exactly the same 2 kUSD test again. It deliberately exceeds the updated 1 kUSD limit.",
      "lines": [
        "Run exactly the same 2 kUSD test again. It deliberately exceeds the updated 1 kUSD limit."
      ]
    },
    {
      "start": 59.99999999999999,
      "end": 70.0,
      "phase": "cap-rejection-confirmed",
      "text": "The receipt confirms a revert. Simulation reported ExceedsPerSwap. Only the ENS cap changed; no app or contract redeployment.",
      "lines": [
        "The receipt confirms a revert. Simulation reported ExceedsPerSwap. Only the ENS cap changed; no app or",
        "contract redeployment."
      ]
    },
    {
      "start": 70.0,
      "end": 79.99999999999999,
      "phase": "restore-cap-five",
      "text": "Restore the cap to 5 kUSD for the next authorization check. This is another owner-approved ENS record update.",
      "lines": [
        "Restore the cap to 5 kUSD for the next authorization check. This is another owner-approved ENS record",
        "update."
      ]
    },
    {
      "start": 79.99999999999999,
      "end": 87.99999999999997,
      "phase": "cap-five-restored",
      "text": "The restored 5 kUSD cap is confirmed. Next, test ENS authorization independently of the amount limit.",
      "lines": [
        "The restored 5 kUSD cap is confirmed. Next, test ENS authorization independently of the amount limit."
      ]
    },
    {
      "start": 87.99999999999997,
      "end": 97.99999999999997,
      "phase": "freeze-request",
      "text": "The owner revokes this agent's ENS authorization role in one Sepolia transaction.",
      "lines": [
        "The owner revokes this agent's ENS authorization role in one Sepolia transaction."
      ]
    },
    {
      "start": 97.99999999999997,
      "end": 105.99999999999996,
      "phase": "freeze-confirmed",
      "text": "Revocation is confirmed. The agent's authority is now revoked; completed trades are not undone.",
      "lines": [
        "Revocation is confirmed. The agent's authority is now revoked; completed trades are not undone."
      ]
    },
    {
      "start": 105.99999999999996,
      "end": 117.99999999999994,
      "phase": "frozen-fixed-test",
      "text": "Request 2 kUSD again. It fits the restored 5 kUSD cap, but the agent no longer has ENS authorization.",
      "lines": [
        "Request 2 kUSD again. It fits the restored 5 kUSD cap, but the agent no longer has ENS authorization."
      ]
    },
    {
      "start": 117.99999999999994,
      "end": 127.99999999999993,
      "phase": "frozen-rejection-confirmed",
      "text": "The receipt confirms a revert. Simulation reported NotAuthorized. A valid agent signature cannot override revocation.",
      "lines": [
        "The receipt confirms a revert. Simulation reported NotAuthorized. A valid agent signature cannot override",
        "revocation."
      ]
    },
    {
      "start": 127.99999999999993,
      "end": 137.9999999999999,
      "phase": "restore-authorization",
      "text": "Only the owner can grant that role again. Restore the agent's ENS authorization.",
      "lines": [
        "Only the owner can grant that role again. Restore the agent's ENS authorization."
      ]
    },
    {
      "start": 137.9999999999999,
      "end": 145.9999999999999,
      "phase": "authorization-restored",
      "text": "Authorization is restored onchain. The agent can again execute requests that satisfy the policy.",
      "lines": [
        "Authorization is restored onchain. The agent can again execute requests that satisfy the policy."
      ]
    },
    {
      "start": 145.9999999999999,
      "end": 154.9999999999999,
      "phase": "gemini-normal-run",
      "text": "Now switch from the deterministic policy test to a real Gemini decision.",
      "lines": [
        "Now switch from the deterministic policy test to a real Gemini decision."
      ]
    },
    {
      "start": 154.9999999999999,
      "end": 163.9999999999999,
      "phase": "gemini-normal-run",
      "text": "Gemini reads news and pool state and may request up to 1 kUSD, or hold. The same ENS policy and hook still apply.",
      "lines": [
        "Gemini reads news and pool state and may request up to 1 kUSD, or hold. The same ENS policy and hook still",
        "apply."
      ]
    },
    {
      "start": 163.9999999999999,
      "end": 173.99999999999986,
      "phase": "gemini-resumed-confirmed",
      "text": "Gemini's requested trade is confirmed on Sepolia. The restored agent has completed the authorization loop.",
      "lines": [
        "Gemini's requested trade is confirmed on Sepolia. The restored agent has completed the authorization loop."
      ]
    },
    {
      "start": 173.99999999999986,
      "end": 185.99999999999983,
      "phase": "integration-proof",
      "text": "Agent reads and signed submissions use Anon-RPC and Nox. Transactions remain public; routing observations are not an anonymity proof.",
      "lines": [
        "Agent reads and signed submissions use Anon-RPC and Nox. Transactions remain public; routing observations",
        "are not an anonymity proof."
      ]
    },
    {
      "start": 185.99999999999983,
      "end": 193.99999999999983,
      "phase": "closing",
      "text": "AI proposes. The owner sets authority. The contracts enforce the boundary. Verify the transaction receipts and source.",
      "lines": [
        "AI proposes. The owner sets authority. The contracts enforce the boundary. Verify the transaction receipts and",
        "source."
      ]
    }

  "captions": [
    {
      "start": 0.0,
      "end": 4.0,
      "phase": "intro",
      "text": "Kusari puts owner-controlled limits around AI trading agents.",
      "lines": [
        "Kusari puts owner-controlled limits around AI trading agents."
      ]
    },
    {
      "start": 4.0,
      "end": 9.999999999999996,
      "phase": "baseline-fixed-test",
      "text": "The vault holds test funds. The policy sets the agent's limits.",
      "lines": [
        "The vault holds test funds. The policy sets the agent's limits."
      ]
    },
    {
      "start": 9.999999999999996,
      "end": 15.999999999999993,
      "phase": "baseline-fixed-test",
      "text": "For this repeatable test, request exactly 2 kUSD under a 5 kUSD cap.",
      "lines": [
        "For this repeatable test, request exactly 2 kUSD under a 5 kUSD cap."
      ]
    },
    {
      "start": 15.999999999999993,
      "end": 22.999999999999993,
      "phase": "baseline-confirmed",
      "text": "The swap succeeds. The transaction link opens its public Sepolia receipt.",
      "lines": [
        "The swap succeeds. The transaction link opens its public Sepolia receipt."
      ]
    },
    {
      "start": 22.999999999999993,
      "end": 34.0,
      "phase": "edit-cap-one",
      "text": "The owner changes the ENS per-trade cap from 5 to 1 kUSD in one transaction.",
      "lines": [
        "The owner changes the ENS per-trade cap from 5 to 1 kUSD in one transaction."
      ]
    },
    {
      "start": 34.0,
      "end": 40.99999999999999,
      "phase": "cap-one-confirmed",
      "text": "The ENS update is confirmed. No application or contract was redeployed.",
      "lines": [
        "The ENS update is confirmed. No application or contract was redeployed."
      ]
    },
    {
      "start": 40.99999999999999,
      "end": 50.99999999999999,
      "phase": "repeat-two-at-one",
      "text": "Repeat the same 2 kUSD request. The hook reads the new 1 kUSD limit.",
      "lines": [
        "Repeat the same 2 kUSD request. The hook reads the new 1 kUSD limit."
      ]
    },
    {
      "start": 50.99999999999999,
      "end": 60.999999999999986,
      "phase": "cap-rejection-confirmed",
      "text": "The receipt confirms a revert. Simulation reported ExceedsPerSwap. The request stayed the same; ENS changed.",
      "lines": [
        "The receipt confirms a revert. Simulation reported ExceedsPerSwap. The request stayed the same; ENS",
        "changed."
      ]
    },
    {
      "start": 60.999999999999986,
      "end": 68.99999999999999,
      "phase": "restore-cap-five",
      "text": "Restore the ENS cap to 5 kUSD before testing authorization separately.",
      "lines": [
        "Restore the ENS cap to 5 kUSD before testing authorization separately."
      ]
    },
    {
      "start": 68.99999999999999,
      "end": 74.99999999999997,
      "phase": "cap-five-restored",
      "text": "Cap 5 is restored. The owner can also revoke the agent's authority.",
      "lines": [
        "Cap 5 is restored. The owner can also revoke the agent's authority."
      ]
    },
    {
      "start": 74.99999999999997,
      "end": 83.99999999999997,
      "phase": "freeze-request",
      "text": "Freeze agent revokes its ENS role in one owner-approved Sepolia transaction.",
      "lines": [
        "Freeze agent revokes its ENS role in one owner-approved Sepolia transaction."
      ]
    },
    {
      "start": 83.99999999999997,
      "end": 91.99999999999996,
      "phase": "freeze-confirmed",
      "text": "Revocation is confirmed. Trading is blocked even though funds and the spending cap remain.",
      "lines": [
        "Revocation is confirmed. Trading is blocked even though funds and the spending cap remain."
      ]
    },
    {
      "start": 91.99999999999996,
      "end": 103.99999999999994,
      "phase": "frozen-fixed-test",
      "text": "Request 2 kUSD again. That amount is within cap 5, but the agent is no longer authorized.",
      "lines": [
        "Request 2 kUSD again. That amount is within cap 5, but the agent is no longer authorized."
      ]
    },
    {
      "start": 103.99999999999994,
      "end": 113.99999999999993,
      "phase": "frozen-rejection-confirmed",
      "text": "The receipt confirms another revert. Simulation reported NotAuthorized. A valid agent signature cannot override revocation.",
      "lines": [
        "The receipt confirms another revert. Simulation reported NotAuthorized. A valid agent signature cannot",
        "override revocation."
      ]
    },
    {
      "start": 113.99999999999993,
      "end": 123.99999999999994,
      "phase": "restore-authorization",
      "text": "The owner restores the ENS role. The agent cannot give itself that permission.",
      "lines": [
        "The owner restores the ENS role. The agent cannot give itself that permission."
      ]
    },
    {
      "start": 123.99999999999994,
      "end": 131.99999999999994,
      "phase": "authorization-restored",
      "text": "Authorization is restored. The same vault and Uniswap hook remain in place.",
      "lines": [
        "Authorization is restored. The same vault and Uniswap hook remain in place."
      ]
    },
    {
      "start": 131.99999999999994,
      "end": 140.99999999999994,
      "phase": "gemini-normal-run",
      "text": "The previous requests were fixed policy tests. Now run the real Gemini agent.",
      "lines": [
        "The previous requests were fixed policy tests. Now run the real Gemini agent."
      ]
    },
    {
      "start": 140.99999999999994,
      "end": 149.99999999999994,
      "phase": "gemini-normal-run",
      "text": "Gemini reads news and chain state, then chooses a 1 kUSD trade within the public demo's ceiling.",
      "lines": [
        "Gemini reads news and chain state, then chooses a 1 kUSD trade within the public demo's ceiling."
      ]
    },
    {
      "start": 149.99999999999994,
      "end": 159.99999999999991,
      "phase": "gemini-resumed-confirmed",
      "text": "Gemini's trade succeeds after restoration. The result shows the requested amount, owner limit, outcome and receipt.",
      "lines": [
        "Gemini's trade succeeds after restoration. The result shows the requested amount, owner limit, outcome and",
        "receipt."
      ]
    },
    {
      "start": 159.99999999999991,
      "end": 171.9999999999999,
      "phase": "integration-proof",
      "text": "The hook checks actual swap output and pool-price movement. Anon-RPC with Nox carries agent RPC traffic; transactions remain public.",
      "lines": [
        "The hook checks actual swap output and pool-price movement. Anon-RPC with Nox carries agent RPC traffic;",
        "transactions remain public."
      ]
    },
    {
      "start": 171.9999999999999,
      "end": 178.9999999999999,
      "phase": "closing",
      "text": "AI proposes. ENS supplies authority. Uniswap enforces the boundary. Verify the code and receipts.",
      "lines": [
        "AI proposes. ENS supplies authority. Uniswap enforces the boundary. Verify the code and receipts."
      ]
    }
  ],

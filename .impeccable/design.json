  "narrative": {
    "northStar": "Dark Product Workspace",
    "overview": "The user selected persistent navigation, a spacious agent workspace and compact policy controls. The system is restrained and task-first: charcoal surfaces, a self-hosted sans, quiet dividers and a soft mint primary action. It presents an operating product rather than a marketing page or a terminal imitation.\n\nThe agent's request and the observed result carry the attention. Policy, permissions and data freshness provide context; shared activity and technical evidence are available through disclosures. These are factual distinctions, so text and semantic structure carry them alongside color.",
    "keyCharacteristics": [
      "Persistent, familiar navigation.",
      "One clear primary request action.",
      "Readable labels and explicit state language.",
      "Flat tonal layering and restrained semantic color.",
      "Real model, policy and transaction evidence."
    ],
    "rules": [
      {
        "name": "The Evidence Color Rule",
        "body": "Color supports explicit state text; it never establishes success, authorization or privacy by itself.",
        "section": "colors"
      },
      {
        "name": "The Product Voice Rule",
        "body": "Labels name an action, object or observed state in sentence case. The interface does not rely on slogans to explain its task.",
        "section": "typography"
      },
      {
        "name": "The Request Summary Rule",
        "body": "A run exposes Agent requested, Owner's limit, Result, Reason and Tx from its own events. Missing or unconfirmed evidence is stated plainly.",
        "section": "components"
      }
    ],
    "dos": [
      "Do retain the selected dark workspace, persistent navigation and clear task hierarchy.",
      "Do use the local Instrument Sans for product copy and reserve monospace for exact data.",
      "Do pair semantic color with explicit state text and visible keyboard focus.",
      "Do keep actual model decisions and transaction evidence separate from shared or recorded history.",
      "Do adapt to the available container width and let long identifiers wrap."
    ],
    "donts": [
      "Don't add decorative metrics, fabricated charts, balances or transaction outcomes.",
      "Don't use a marketing hero, glowing panels or terminal decoration as the workspace's main structure.",
      "Don't imply that a routing observation hides public transactions or the visitor wallet's RPC.",
      "Don't turn every explanation into another nested card or badge.",
      "Don't hide a hold, unknown revert, timeout or stale reading behind a positive color."
    ]
  }
}

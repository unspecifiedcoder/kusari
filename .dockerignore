# Default-deny context: only backend source and locked dependencies enter the remote build.
**
!Dockerfile
!.dockerignore
!fly.toml
!reader/
!reader/package.json
!reader/package-lock.json
!reader/build.mjs
!reader/src/
!reader/src/**
!agent/
!agent/package.json
!agent/package-lock.json
!agent/src/
!agent/src/**
!proxy/
!proxy/server.mjs
!shared/
!shared/types.ts
!config/
!config/chains.json
!deployments/
!deployments/*.json
!scripts/
!scripts/demo-gateway.mjs
!scripts/start-hosted-demo.mjs
!scripts/present-hosted-demo.mjs
!scripts/sandbox-access.mjs

# These exclusions win even if a future source include is widened.
**/.env
**/.env.*
**/.git
**/.git/**
**/node_modules
**/node_modules/**
**/.next
**/.next/**
**/.tools/**
**/.vercel/**
**/work/**
**/outputs/**
**/dist/**
**/out/**
**/build/**
**/cache/**
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*credentials*
**/*private-key*
**/secrets/**
**/*-fork.json
